NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Optional public URL for Swagger and startup logs when the API is exposed via proxy/domain.
# API_PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:5173

POSTGRES_DB=smarteach
POSTGRES_USER=smarteach
POSTGRES_PASSWORD=smarteach
DATABASE_URL=postgresql://smarteach:smarteach@localhost:5432/smarteach?schema=public

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=smarteach
MINIO_ROOT_PASSWORD=smarteachminio
MINIO_BUCKET=smarteach-files
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=smarteach-api
JWT_AUDIENCE=smarteach-clients
PASSWORD_HASH_ROUNDS=12
SWAGGER_ENABLED=true
