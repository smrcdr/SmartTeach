{
  "name": "smarteach",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w @smarteach/web",
    "dev:api": "npm run dev -w @smarteach/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build -w @smarteach/web",
    "build:api": "npm run build -w @smarteach/api",
    "test:api": "npm --prefix apps/api test",
    "prisma:generate": "npm run prisma:generate -w @smarteach/api",
    "db:migrate": "npm run db:migrate -w @smarteach/api",
    "db:seed": "npm run db:seed -w @smarteach/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
